[tool.poetry]
name = "bank-masks"
version = "0.1.0"
description = "Bank card and account number masking"
authors = ["Student <student@example.com>"]

[tool.poetry.dependencies]
python = "^3.8.1"

[tool.poetry.group.lint.dependencies]
flake8 = "^6.0.0"
black = "^23.0.0"
isort = "^5.12.0"
mypy = "^1.0.0"
pytest = "^7.0.0"

[tool.black]
line-length = 119
exclude = '''\.git'''

[tool.isort]
line_length = 119
multi_line_output = 3

[tool.mypy]
disallow_untyped_defs = true
warn_return_any = true
exclude = ["venv"]
